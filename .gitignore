# Flutter/Dart: локальные артефакты инструментария.
# Их отсутствие в списке и привело к тому, что `git add apps/main_app`
# подтянул .dart_tool и google-services.json в индекс.
.dart_tool/

# Melos: локальные state-файлы воркспейса, генерируются `melos bootstrap`.
# В индекс их класть нельзя — они содержат абсолютные пути этого checkout.
**/pubspec_overrides.yaml
.melos/
melos_*.iml

.flutter-plugins
.flutter-plugins-dependencies
.pub/
.packages
app.*.symbols
app.*.map.json

# Android: ключ подписи и конфиги Firebase — секреты, в репозиторий не входят.
# Если такой файл действительно нужен в коммите — `git add -f <путь>`.
*.jks
*.keystore
google-services.json
GoogleService-Info.plist

# Исключение из правила: Firebase-конфиги клиента — не секрет (публичный
# API-ключ, app id и project id, которые всё равно лежат в собранном
# приложении). Без них не собирается iOS-таргет и рвётся CI.
!apps/main_app/ios/Runner/GoogleService-Info.plist

# Cargo-таргеты, зашитые symlink-ом (паттерн `target/` symlink не ловит).
crates/*/target

# Веб-плеер: .wasm и JS-шейпинг — выход wasm-pack, пересобирается, в индекс не идёт.
apps/web_player/web/pkg/
