// Необязательный локальный конфиг. Скопируйте этот файл в OAuth.xcconfig,
// только если нужно переопределить значения по умолчанию. OAuth.xcconfig
// исключён из git; в репозитории лежат шаблон и OAuthDefaults.xcconfig,
// которого достаточно для сборки с чистого клона.
//
// GOOGLE_IOS_REVERSED_CLIENT_ID — клиентский ID в обратном порядке:
// PROJECT_NUMBER-CLIENT_HASH.apps.googleusercontent.com →
// com.googleusercontent.apps.PROJECT_NUMBER-CLIENT_HASH

GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_REVERSED_CLIENT_ID=
GOOGLE_MOBILE_SERVER_CLIENT_ID=
YANDEX_CLIENT_ID=
