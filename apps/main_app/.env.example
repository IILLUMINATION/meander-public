# Необязательный файл. Скопируйте его в apps/main_app/.env, только если нужно
# переопределить значения по умолчанию. .env исключён из git; в репозитории
# лежит только этот шаблон.
#
# Для обычной сборки файл не нужен: публичные client id уже вшиты дефолтами
# (lib/core/oauth_config.dart и ios/Flutter/OAuthDefaults.xcconfig), а вход
# через Google на iOS/Android работает без единого ключа.
#
# Пустая переменная считается незаданной и НЕ перекрывает дефолт. Поэтому
# старый .env, скопированный из этого шаблона до появления дефолтов, после
# git pull ничего не ломает.
#
# GOOGLE_DESKTOP_CLIENT_SECRET не обязателен: без него код для Google на
# десктопе обменивает наш сервер (POST /auth/google/exchange), у которого
# секрет есть. Задавайте его, только если собираете против своего бэкенда без
# этого эндпоинта.
#
# Сборка с переопределениями:
#   cd apps/main_app
#   flutter build linux --release --dart-define-from-file=.env

GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
GOOGLE_MOBILE_SERVER_CLIENT_ID=
YANDEX_CLIENT_ID=
TELEGRAM_CLIENT_ID=
