# Скопируйте этот файл в apps/main_app/.env, только если нужно переопределить
# значения по умолчанию. .env исключён из git; в репозитории лежит только
# этот шаблон.
#
# Публичные client id уже вшиты дефолтами (lib/core/oauth_config.dart и
# ios/Flutter/OAuthDefaults.xcconfig), поэтому сборка с чистого клона работает
# без этого файла. При `--dart-define-from-file=.env` значения отсюда главнее.
#
# Единственное значение, у которого нет дефолта, — GOOGLE_DESKTOP_CLIENT_SECRET:
# он нужен только для входа через Google на десктопе.
#
# Сборка с переопределениями:
#   cd apps/main_app
#   flutter build linux --release --dart-define-from-file=.env

GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
GOOGLE_MOBILE_SERVER_CLIENT_ID=
YANDEX_CLIENT_ID=
TELEGRAM_CLIENT_ID=
